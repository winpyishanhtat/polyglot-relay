# Copy to .env (or export these directly) before running translator workers
# or the real-translation Docker Compose overlay. Only GEMINI_API_KEY is
# required; everything else has a working default (see README.md's
# "Gemini API tier" section and translator_worker.py's Translator.__init__).

# Required for any Gemini-backed translation (text or Live). Get one at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# "paid" (default) assumes GEMINI_API_KEY belongs to a billing-enabled
# Google Cloud project: skips the per-worker stagger delay and defaults to
# the higher-quality Pro text model. Set to "free" if your key has no
# billing account attached, to restore the staggered, Flash-model defaults
# that keep a 9-language broadcast under the free tier's rate limit.
GEMINI_TIER=free

# This is a local request budget, not a universal Google quota.
# Match the selected model's active RPM limit in Google AI Studio.
GEMINI_RATE_LIMIT_PER_MINUTE=5
# File transcription window (5 to 60 seconds). One speech chunk fans out
# into eight Gemini requests. Longer windows reduce request pressure.
POLYGLOT_FILE_CHUNK_SECONDS=15

# Optional overrides - leave unset to use GEMINI_TIER's defaults.
# GEMINI_TEXT_MODEL=gemini-pro-latest
#
# Model used to transcribe Burmese/Khmer/Lao speech (Whisper cannot). Defaults to
# GEMINI_TEXT_MODEL, then gemini-flash-latest. Audio transcription latency varies a
# lot between models - a Flash-Lite model can take 15-20s for a 4s live slice, so
# measure before choosing. Do not set a thinking level: some models reject it (400).
# GEMINI_STT_MODEL=gemini-flash-latest
#
# Live captions: slices transcribed in parallel (1-6, default 3), and how long a stuck
# slice may hold up later captions before being skipped as a gap (default 20).
# POLYGLOT_LIVE_WORKERS=3
# POLYGLOT_LIVE_MAX_HOLD_SECONDS=20
#
# Live captions cut the microphone at pauses between phrases, not every N seconds, and
# never send a slice with no speech in it. A slice is at least MIN and at most MAX
# seconds long; PAUSE is how long a gap must last to end a phrase. Longer slices give
# the transcriber more context (better accuracy) but captions arrive later.
# POLYGLOT_LIVE_MIN_SLICE_SECONDS=2
# POLYGLOT_LIVE_MAX_SLICE_SECONDS=8
# POLYGLOT_LIVE_PAUSE_MS=350
#
# Burmese/Khmer/Lao captions are translated to English once by the dashboard and the
# workers reuse it (LibreTranslate cannot read those languages), cutting Gemini calls
# per chunk from 8 to 3. Set POLYGLOT_PIVOT=0 to make every worker translate directly
# from the original text instead (more calls, no two-step translation).
# POLYGLOT_PIVOT=1
# How long the languages that use the pivot wait for it before translating directly
# instead. Must exceed one Gemini call: gemini-3.1-flash-lite took 11-19s for a short
# phrase when measured, so a shorter value means the pivot never finishes in time.
# POLYGLOT_PIVOT_TIMEOUT=25
#
# If a billing-enabled key still gets 429s tagged "-FreeTier" in the worker
# logs (Google's own quota dashboards showing paid-tier limits doesn't
# always mean every model has actually picked that up server-side yet -
# confirmed on a real key where gemini-3.6-flash stayed stuck on free-tier
# enforcement while gemini-3.7-flash correctly reflected the paid tier),
# try pinning an explicit newer model name here instead of the tier
# default - it may simply have propagated further than the older one.
# GEMINI_LIVE_MODEL=gemini-3.5-live-translate-preview
# GEMINI_LIVE_TIMEOUT=30
# GEMINI_MAX_RETRIES=5
# POLYGLOT_STAGGER_STEP_SECONDS=0.0

# "auto" (default) tries the free, self-hosted LibreTranslate service first
# and falls back to Gemini only for languages it doesn't cover (my/km/lo).
# "libretranslate" pins to LibreTranslate only; "gemini" skips it entirely.
# Live captions: LibreTranslate manages only ~2 requests/s on one machine, so with a
# billing-enabled key "gemini" gives every language a ~2s answer in parallel.
# TRANSLATION_BACKEND=auto
# LIBRETRANSLATE_URL=http://libretranslate:5000

# --- Putting the dashboard on a network others can reach -----------------------
# Viewing stays open; every change (submit text, upload, live mic, clear) must carry
# this secret. Share the audience-control link as http(s)://HOST:8000/?token=THIS
# POLYGLOT_ACCESS_TOKEN=
# Changes allowed per client address per minute (0 = unlimited, default 240).
# POLYGLOT_RATE_LIMIT_PER_MINUTE=240
# Load the Whisper model when the dashboard starts (default on; 0 to load on first use).
# POLYGLOT_PRELOAD_WHISPER=1
# Audio shorter than this, or completely silent, is never sent to Gemini for Burmese/Khmer/Lao.
# POLYGLOT_MIN_WINDOW_SECONDS=0.7
# ...or whose loudest sample is below this (0-1, default 0.001; real quiet speech peaks near 0.002).
# POLYGLOT_SILENCE_PEAK=0.001
# Which spoken languages Gemini transcribes (Whisper is the fallback where it can read the language):
# "all" (default), "none" (Whisper for everything it can read, as before), or a list such as my,km,lo,vi.
# Burmese, Khmer and Lao are always Gemini. On real FLEURS speech Gemini made 2-7x fewer character
# errors than Whisper base, and live Vietnamese through Whisper dropped 26 of 29 slices.
# POLYGLOT_GEMINI_STT_LANGUAGES=all
# History panel: how many spoken chunks the dashboard remembers (default 2000) and, optionally, for
# how long (minutes; 0 = no age limit). Held in memory only: a restart or Clear empties it, so export
# anything you need to keep.
# POLYGLOT_HISTORY_CHUNKS=2000
# POLYGLOT_HISTORY_MINUTES=0
# Also needed: HTTPS in front (browsers only allow the microphone on https or localhost) and
# a spend cap on the Gemini key. Broker (7001/7002) and LibreTranslate (5001) ports are
# published on 127.0.0.1 only.
