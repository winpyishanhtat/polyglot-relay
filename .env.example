# Copy to .env (or export these directly) before running translator workers
# or the real-translation Docker Compose overlay. Only GEMINI_API_KEY is
# required; everything else has a working default (see README.md's
# "Gemini API tier" section and translator_worker.py's Translator.__init__).

# Required for any Gemini-backed translation (text or Live). Get one at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# "paid" (default) assumes GEMINI_API_KEY belongs to a billing-enabled
# Google Cloud project: skips the per-worker stagger delay and defaults to
# the higher-quality Pro text model. Set to "free" if your key has no
# billing account attached, to restore the staggered, Flash-model defaults
# that keep a 9-language broadcast under the free tier's rate limit.
GEMINI_TIER=free

# This is a local request budget, not a universal Google quota.
# Match the selected model's active RPM limit in Google AI Studio.
GEMINI_RATE_LIMIT_PER_MINUTE=5
# File transcription window (5 to 60 seconds). One speech chunk fans out
# into eight Gemini requests. Longer windows reduce request pressure.
POLYGLOT_FILE_CHUNK_SECONDS=15

# Optional overrides - leave unset to use GEMINI_TIER's defaults.
# GEMINI_TEXT_MODEL=gemini-pro-latest
#
# Model used to transcribe Burmese/Khmer/Lao speech (Whisper cannot). Defaults to
# GEMINI_TEXT_MODEL, then gemini-flash-latest. Audio transcription latency varies a
# lot between models - a Flash-Lite model can take 15-20s for a 4s live slice, so
# measure before choosing. Do not set a thinking level: some models reject it (400).
# GEMINI_STT_MODEL=gemini-flash-latest
#
# Live captions: slices transcribed in parallel (1-6, default 3), and how long a stuck
# slice may hold up later captions before being skipped as a gap (default 20).
# POLYGLOT_LIVE_WORKERS=3
# POLYGLOT_LIVE_MAX_HOLD_SECONDS=20
#
# If a billing-enabled key still gets 429s tagged "-FreeTier" in the worker
# logs (Google's own quota dashboards showing paid-tier limits doesn't
# always mean every model has actually picked that up server-side yet -
# confirmed on a real key where gemini-3.6-flash stayed stuck on free-tier
# enforcement while gemini-3.7-flash correctly reflected the paid tier),
# try pinning an explicit newer model name here instead of the tier
# default - it may simply have propagated further than the older one.
# GEMINI_LIVE_MODEL=gemini-3.5-live-translate-preview
# GEMINI_LIVE_TIMEOUT=30
# GEMINI_MAX_RETRIES=5
# POLYGLOT_STAGGER_STEP_SECONDS=0.0

# "auto" (default) tries the free, self-hosted LibreTranslate service first
# and falls back to Gemini only for languages it doesn't cover (my/km/lo).
# "libretranslate" pins to LibreTranslate only; "gemini" skips it entirely.
# TRANSLATION_BACKEND=auto
# LIBRETRANSLATE_URL=http://libretranslate:5000
